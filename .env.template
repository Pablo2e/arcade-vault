# Arcade Vault — variables de entorno (SPEC 03)
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore: nunca se commitea.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Dirección que recibe los mensajes del formulario de contacto
CONTACT_TO_EMAIL=

# Remitente; debe pertenecer a un dominio verificado en Resend
FROM_EMAIL=
