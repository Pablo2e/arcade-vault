# Arcade Vault — variables de entorno (SPEC 03, SPEC 04)
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore: nunca se commitea.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Dirección que recibe los mensajes del formulario de contacto
CONTACT_TO_EMAIL=

# Remitente; debe pertenecer a un dominio verificado en Resend
FROM_EMAIL=

# Contraseña de la base de datos de Supabase. Opcional: la app no la lee.
# Solo sirve para conexión directa a la base (psql, futuras migraciones).
SUPABASE_DB_PASSWORD=

# Project URL del dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key de Supabase (pública por diseño; NO es la service_role key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
