# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.playwright-screenshots/*
!.playwright-screenshots/.gitkeep

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.template

# vercel
.vercel

# supabase cli local state (npx supabase …)
/supabase/.temp/

# temp DSNs con credenciales de la base (nunca commitear)
.dsns.tmp
*.dsns.tmp

# typescript
*.tsbuildinfo
next-env.d.ts
